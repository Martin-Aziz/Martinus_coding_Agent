{
  "name": "martinus-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "icons:refresh": "tauri icon ./src-tauri/icons/martinus.svg --output ./src-tauri/icons",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles msi,nsis",
    "windows:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "windows:build:nobundle": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -NoBundle",
    "macos:build": "./scripts/build-macos.sh",
    "macos:build:nobundle": "./scripts/build-macos.sh --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
