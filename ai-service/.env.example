AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=local-model

MEMORY_DB_PATH=./data/memory.sqlite3
AI_HTTP_TIMEOUT_SECONDS=90

# Cross-session memory penalty (manually chosen, not grid-searched). Range: 0.0–1.0.
MEMORY_CROSS_SESSION_PENALTY=0.92

# Set to true to activate the /v1/self-consistency endpoint.
# Disabled by default; the 20-task ablation did not use this endpoint.
SELF_CONSISTENCY_ENABLED=false
